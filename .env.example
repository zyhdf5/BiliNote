# Required LLM configuration
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=mock
LLM_MODEL=Qwen/Qwen3.5-9B

# Optional Bilibili login state (e.g. SESSDATA=...; bili_jct=...)
BILIBILI_COOKIE=

# Recommended when publishing beyond localhost. healthz/readyz stay unauthenticated.
# Docker Compose binds to 127.0.0.1 by default; change that deliberately if remote access is required.
WEB_USERNAME=
WEB_PASSWORD=

# Docker/runtime options
APP_PORT=8080
TZ=Asia/Shanghai
HF_ENDPOINT=https://hf-mirror.com
BASE_REGISTRY=docker.io
PIP_INDEX=https://pypi.org/simple
